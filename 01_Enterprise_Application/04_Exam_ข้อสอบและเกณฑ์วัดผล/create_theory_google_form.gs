function createTheoryExamForm() {
  const exam = {"title": "ข้อสอบทฤษฎี", "subject": "การออกแบบ พัฒนา และบูรณาการแอปพลิเคชันระดับองค์กร", "minutes": 60, "instructions": ["ข้อสอบมี 2 ตอน รวม 50 คะแนน เวลา 60 นาที (ตอนที่ 1 ปรนัย 30 คะแนน · ตอนที่ 2 อัตนัย 20 คะแนน)", "กติกา Open-World: อนุญาตให้เปิดสไลด์ โค้ดตัวอย่าง อินเทอร์เน็ต ใช้ AI ปรึกษาเพื่อน และถามอาจารย์ผู้สอนได้ทุกช่องทาง", "เน้นความเข้าใจและการนำไปใช้จริง: ตอนที่ 2 ให้เขียนอธิบายด้วยภาษาของตนเองและยกตัวอย่างให้ตรงตามโจทย์"], "partA": [{"clo": "CLO01", "topic": "Digital Transformation", "q": "ข้อใดเป็นข้อดีของระบบดิจิทัลเมื่อเทียบกับระบบเอกสารกระดาษ", "choices": ["ไม่ต้องสำรองข้อมูลอีกต่อไป", "ไม่ต้องกำหนดสิทธิ์ว่าใครเข้าถึงข้อมูลได้", "มีประวัติการแก้ไข ตรวจสอบย้อนหลังได้ว่าใครแก้อะไร", "ใช้ได้ทันทีโดยไม่ต้องเปลี่ยนวิธีทำงานของคน"], "answer": 2, "why": "ระบบดิจิทัลเก็บประวัติการแก้ไขได้ ส่วนการสำรองข้อมูล การกำหนดสิทธิ์ และการปรับวิธีทำงานยังจำเป็นเสมอ"}, {"clo": "CLO01", "topic": "Application Architecture", "q": "ข้อใดอธิบายสถาปัตยกรรมแบบ Microservices ได้ถูกต้อง", "choices": ["รวมทุกฟังก์ชันไว้ในโปรแกรมเดียวขนาดใหญ่", "แบ่งระบบเป็นบริการย่อยที่พัฒนาและอัปเดตแยกกันได้", "แอปที่ทำงานได้เฉพาะบนเครื่องของผู้ใช้", "ฐานข้อมูลที่มีตารางเดียวสำหรับทุกระบบ"], "answer": 1, "why": "Microservices แยกระบบเป็นบริการเล็ก ๆ แต่ละบริการ deploy และขยายได้อิสระ"}, {"clo": "CLO01", "topic": "IT vs OT", "q": "ระยะเวลาตอบสนอง (Response Time) ที่ระบบ OT ต้องการโดยทั่วไปอยู่ในระดับใด", "choices": ["ระดับมิลลิวินาทีถึงวินาที (Real-time)", "ระดับวินาทีถึงนาที ยอมให้ช้าได้บ้าง", "ระดับชั่วโมง", "ไม่มีข้อกำหนดเรื่องเวลา"], "answer": 0, "why": "OT ควบคุมเครื่องจักรจึงต้องตอบสนองแบบ Real-time ส่วน IT ยอมรับเวลาระดับวินาทีถึงนาทีได้ (อ้างอิง NIST SP 800-82 Rev.3)"}, {"clo": "CLO01", "topic": "IT vs OT", "q": "เหตุใดการอัปเดตซอฟต์แวร์ในระบบ OT จึงทำได้ไม่บ่อยเท่าระบบ IT", "choices": ["เพราะระบบ OT ไม่มีซอฟต์แวร์", "เพราะระบบ OT ใช้งานได้เฉพาะบน Cloud", "เพราะกฎหมายห้ามอัปเดตระบบในโรงงาน", "เพราะมักต้องหยุดเครื่องจักร ซึ่งกระทบการผลิตและความปลอดภัย"], "answer": 3, "why": "OT ทนต่อการหยุดเครื่องได้น้อย การอัปเดตจึงต้องวางแผนและทำนาน ๆ ครั้ง (อ้างอิง NIST SP 800-82 Rev.3)"}, {"clo": "CLO04", "topic": "UX/UI", "q": "Wireframe คืออะไร", "choices": ["หน้าจอจริงที่ลงสีและใส่ข้อมูลครบแล้ว", "เอกสารที่ผู้ใช้ลงชื่อยอมรับระบบ", "ไฟล์ CSS ที่กำหนดสีของระบบ", "ภาพร่างโครงหน้าจอแบบง่าย ใช้คุยเรื่องการจัดวางก่อนลงรายละเอียด"], "answer": 3, "why": "Wireframe คือโครงร่างหน้าจอ (Low-fidelity) ใช้ตกลงการจัดวางก่อนทำ UI จริง (อ้างอิง ISO 9241-210 ใช้ต้นแบบหน้าจอเพื่อทดสอบกับผู้ใช้ตั้งแต่ต้น)"}, {"clo": "CLO04", "topic": "UX/UI", "q": "หน้าจอบนแท็บเล็ตที่พนักงานใช้หน้างาน ปุ่มควรมีขนาดอย่างน้อยเท่าไร", "choices": ["16 × 16 px", "24 × 24 px", "44 × 44 px และเว้นระยะระหว่างปุ่ม 8 px ขึ้นไป", "ไม่ต้องกำหนด เพราะผู้ใช้ซูมได้เอง"], "answer": 2, "why": "ปุ่มสำหรับการแตะต้องมีขนาดอย่างน้อย 44 × 44 px และเว้นระยะ เพื่อลดการกดพลาด (อ้างอิง WCAG 2.2 เกณฑ์ 2.5.5 แนะนำ 44 × 44 px (AAA) ส่วนขั้นต่ำตามเกณฑ์ 2.5.8 คือ 24 × 24 px (AA))"}, {"clo": "CLO04", "topic": "UX/UI", "q": "เหตุใดหน้าจอแสดงสถานะเครื่องจักรควรมีไอคอนหรือข้อความกำกับคู่กับสี", "choices": ["เพราะผู้ใช้บางคนแยกสีไม่ได้ ไอคอนและข้อความช่วยให้อ่านสถานะได้ทุกคน", "เพื่อให้หน้าจอดูสวยขึ้นเท่านั้น", "เพราะเบราว์เซอร์บางตัวแสดงสีไม่ได้", "เพราะการใช้สีทำให้หน้าเว็บโหลดช้า"], "answer": 0, "why": "ประมาณ 8% ของผู้ชายมีภาวะตาบอดสี จึงไม่ควรใช้สีเป็นสัญญาณเพียงอย่างเดียว (อ้างอิง WCAG 2.2 เกณฑ์ 1.4.1 Use of Color)"}, {"clo": "CLO03", "topic": "HTML", "q": "เนื้อหาที่อยู่ในส่วนใดของเอกสาร HTML จะแสดงให้ผู้ใช้เห็นบนหน้าเว็บ", "choices": ["<head>", "<body>", "<!DOCTYPE html>", "<meta>"], "answer": 1, "why": "<body> เก็บเนื้อหาที่แสดงผล ส่วน <head> เก็บข้อมูลเกี่ยวกับหน้า เช่น title และการเชื่อมไฟล์ CSS (อ้างอิง HTML Living Standard (WHATWG))"}, {"clo": "CLO03", "topic": "HTML", "q": "ต้องการใช้สไตล์จากไฟล์ style.css ภายนอก ต้องเขียนแท็กใดใน <head>", "choices": ["<style src=\"style.css\">", "<css href=\"style.css\">", "<script href=\"style.css\">", "<link rel=\"stylesheet\" href=\"style.css\">"], "answer": 3, "why": "ไฟล์ CSS ภายนอกเชื่อมด้วย <link rel=\"stylesheet\" href=\"...\">"}, {"clo": "CLO03", "topic": "HTML", "q": "ข้อใดถูกต้องเกี่ยวกับ id และ class", "choices": ["id ต้องไม่ซ้ำกันในหน้าเดียว ส่วน class ใช้ซ้ำกับหลาย element ได้", "class ต้องไม่ซ้ำกัน ส่วน id ใช้ซ้ำได้", "ทั้ง id และ class ใช้ซ้ำไม่ได้", "id ใช้ได้เฉพาะกับแท็ก <div>"], "answer": 0, "why": "id ระบุ element เดียว เหมาะให้ JavaScript เลือก ส่วน class ใช้กับกลุ่ม element ที่แต่งแบบเดียวกัน (อ้างอิง HTML Living Standard กำหนดให้ id ไม่ซ้ำกันในเอกสาร)"}, {"clo": "CLO03", "topic": "CSS", "q": "ต้องการให้การ์ด 3 ใบเรียงต่อกันเป็นแถวเดียว ควรเขียน CSS ใดที่กล่องที่ครอบการ์ด", "choices": ["display: flex;", "display: none;", "position: absolute;", "text-align: center;"], "answer": 0, "why": "display: flex ที่กล่องแม่ทำให้ลูกเรียงเป็นแถว และใช้ gap กำหนดระยะห่างได้ (อ้างอิง CSS Flexible Box Layout Module Level 1 (W3C))"}, {"clo": "CLO03", "topic": "CSS", "q": "ลำดับชั้นของ Box Model จากด้านในออกไปด้านนอกคือข้อใด", "choices": ["content → margin → border → padding", "padding → content → border → margin", "content → padding → border → margin", "border → padding → content → margin"], "answer": 2, "why": "เนื้อหา (content) ถูกล้อมด้วย padding, border และ margin ตามลำดับ (อ้างอิง CSS Box Model Module Level 3 (W3C))"}, {"clo": "CLO03", "topic": "JavaScript", "q": "เมื่อรันโค้ด  const total = 10;  total = 20;  จะเกิดอะไรขึ้น", "choices": ["total มีค่า 20", "total มีค่า 30", "total ยังเป็น 10 โดยไม่มี error", "เกิด error เพราะ const กำหนดค่าใหม่ไม่ได้"], "answer": 3, "why": "ตัวแปร const กำหนดค่าใหม่ไม่ได้ (TypeError: Assignment to constant variable) ถ้าต้องเปลี่ยนค่าให้ใช้ let (อ้างอิง ECMAScript 2015 (ECMA-262 ฉบับที่ 6))"}, {"clo": "CLO03", "topic": "JavaScript", "q": "let temp = 85; ถ้า temp > 90 ได้ 'วิกฤต', else if temp > 80 ได้ 'เตือน', else ได้ 'ปกติ' ผลลัพธ์คือข้อใด", "choices": ["'วิกฤต'", "'เตือน'", "'ปกติ'", "ได้ทั้ง 'เตือน' และ 'ปกติ'"], "answer": 1, "why": "85 ไม่มากกว่า 90 แต่มากกว่า 80 จึงเข้าเงื่อนไข else if และหยุดเช็กเงื่อนไขที่เหลือ"}, {"clo": "CLO03", "topic": "JavaScript", "q": "ถ้า running = true และ temp = 70 นิพจน์ใดได้ผลเป็น true", "choices": ["running && temp > 80", "!running", "running || temp > 80", "temp > 80"], "answer": 2, "why": "|| เป็นจริงเมื่อมีอย่างน้อยหนึ่งฝั่งเป็นจริง running เป็น true จึงได้ true"}, {"clo": "CLO03", "topic": "JavaScript", "q": "const parts = ['A', 'B', 'C']; parts.push('D'); ค่า parts[3] คืออะไร", "choices": ["'C'", "เกิด error เพราะ parts เป็น const", "undefined", "'D'"], "answer": 3, "why": "push เพิ่ม 'D' ต่อท้ายที่ index 3 และ const ห้ามแค่กำหนดค่าใหม่ทั้งตัวแปร แต่แก้ข้างใน Array ได้ (อ้างอิง ECMAScript 2015 (ECMA-262 ฉบับที่ 6))"}, {"clo": "CLO03", "topic": "DOM", "q": "document.querySelector('.card') ได้ผลลัพธ์เป็นอะไร", "choices": ["element แรกในหน้าที่มี class=\"card\"", "ทุก element ที่มี class=\"card\"", "element ที่มี id=\"card\"", "ข้อความทั้งหมดใน element ที่ชื่อ card"], "answer": 0, "why": "querySelector คืน element แรกที่ตรงกับ CSS Selector ถ้าต้องการทุกตัวใช้ querySelectorAll"}, {"clo": "CLO03", "topic": "DOM", "q": "ต้องการแสดงข้อความที่ผู้ใช้พิมพ์ลงบนหน้าเว็บอย่างปลอดภัย ควรใช้คำสั่งใด", "choices": ["element.innerHTML = text", "element.textContent = text", "document.write(text)", "element.outerHTML = text"], "answer": 1, "why": "textContent แสดงเป็นข้อความเสมอ ส่วน innerHTML จะตีความแท็ก HTML จึงเปิดช่องให้ฝังโค้ดอันตราย (XSS) (อ้างอิง OWASP Cross Site Scripting Prevention Cheat Sheet)"}, {"clo": "CLO03", "topic": "DOM", "q": "ในฟังก์ชันที่รับ Event เช่น function onClick(event) ค่า event.target คืออะไร", "choices": ["เวลาที่เกิด Event", "ชื่อฟังก์ชันที่ถูกเรียก", "element ที่ทำให้เกิด Event เช่น ปุ่มที่ถูกกด", "หน้าเว็บทั้งหน้า"], "answer": 2, "why": "event.target ชี้ไปที่ element ต้นเหตุ ทำให้ใช้ฟังก์ชันเดียวกับหลายปุ่มได้"}, {"clo": "CLO02", "topic": "JSON", "q": "ข้อใดเป็น JSON ที่ถูกต้อง", "choices": ["{\"temp\": 72.5, \"online\": true}", "{\"temp\": 72.5,}", "{'temp': 72.5}", "{\"temp\": 72.5 // องศา}"], "answer": 0, "why": "JSON ต้องใช้เครื่องหมายคำพูดคู่ ห้ามมี comma ตัวสุดท้าย และห้ามมี comment (อ้างอิง RFC 8259)"}, {"clo": "CLO02", "topic": "JSON", "q": "data = {\"lines\": [{\"name\": \"A\", \"machines\": [{\"id\": \"M-01\"}, {\"id\": \"M-02\"}]}]}  ต้องเขียนอย่างไรจึงได้ \"M-02\"", "choices": ["data.machines[1].id", "data.lines[0].machines[1].id", "data.lines.machines[2].id", "data[0].machines[1]"], "answer": 1, "why": "ไล่ทีละชั้น: lines เป็น Array เลือกตัวแรก [0] แล้ว machines เป็น Array เลือกตัวที่สอง [1] แล้วอ่าน .id"}, {"clo": "CLO02", "topic": "JSON", "q": "JSON.stringify(obj) ใช้ทำอะไร", "choices": ["แปลงข้อความ JSON เป็น Object", "ตรวจว่า JSON ถูกต้องหรือไม่", "ลบ key ที่ไม่ใช้ออกจาก Object", "แปลง Object เป็นข้อความ JSON เพื่อส่งไปยัง Server"], "answer": 3, "why": "stringify แปลง Object เป็นข้อความ ใช้ตอนส่ง body ส่วน JSON.parse ทำกลับกัน"}, {"clo": "CLO02", "topic": "JSON", "q": "ใน JSON  {\"alarm\": null}  ค่า null หมายถึงอะไร", "choices": ["ข้อความว่าง \"\"", "ตัวเลข 0", "ไม่มีค่า (ว่างโดยตั้งใจ)", "ข้อมูลผิดพลาด"], "answer": 2, "why": "null แปลว่าไม่มีค่า เช่น ตอนนี้ไม่มี alarm ต่างจากข้อความว่างหรือเลข 0 (อ้างอิง RFC 8259)"}, {"clo": "CLO05", "topic": "HTTP Method", "q": "ต้องการแก้สถานะของเครื่อง M-01 ที่มีอยู่แล้วผ่าน REST API ควรใช้ HTTP Method ใด", "choices": ["GET", "PUT", "POST", "DELETE"], "answer": 1, "why": "GET อ่าน, POST สร้างใหม่, PUT แก้ไขข้อมูลเดิม, DELETE ลบ (อ้างอิง RFC 9110 HTTP Semantics: PUT แทนที่ข้อมูลเดิมและเป็น idempotent)"}, {"clo": "CLO05", "topic": "HTTP Status", "q": "API ตอบกลับด้วย Status 404 หมายถึงอะไร", "choices": ["สำเร็จ", "ไม่มีสิทธิ์เข้าถึง", "Server เกิดข้อผิดพลาดภายใน", "ไม่พบข้อมูลหรือ URL ที่ขอ"], "answer": 3, "why": "404 Not Found คือ URL ผิดหรือไม่มีข้อมูลนั้น ส่วน 500 คือ Server พัง และ 401/403 เกี่ยวกับสิทธิ์ (อ้างอิง RFC 9110 HTTP Semantics หมวด Status Codes)"}, {"clo": "CLO05", "topic": "fetch", "q": "เหตุใดหลังเรียก fetch แล้วควรตรวจ response.ok ก่อนใช้ข้อมูล", "choices": ["เพราะ fetch ไม่ throw error เมื่อ Server ตอบ 404 หรือ 500 ต้องตรวจเอง", "เพราะถ้าไม่ตรวจ ข้อมูลจะไม่ถูกแปลงเป็น JSON", "เพราะ response.ok ทำให้เรียก API ได้เร็วขึ้น", "เพราะเป็นข้อบังคับของ HTML5"], "answer": 0, "why": "fetch จะเข้า catch เฉพาะตอนต่อเครือข่ายไม่ได้ ถ้าได้ 404/500 ต้องเช็ก response.ok แล้วจัดการเอง (อ้างอิง Fetch Living Standard (WHATWG): fetch reject เฉพาะเมื่อเกิด network error)"}, {"clo": "CLO05", "topic": "fetch", "q": "การส่งข้อมูล JSON ไปยัง API ด้วย fetch แบบ POST ต้องกำหนด header ใด", "choices": ["'Accept-Language': 'th'", "'Cache-Control': 'no-cache'", "'Content-Type': 'application/json'", "'Content-Type': 'text/html'"], "answer": 2, "why": "Content-Type: application/json บอก Server ว่า body เป็น JSON และต้องใช้คู่กับ JSON.stringify (อ้างอิง RFC 8259 กำหนด media type application/json)"}, {"clo": "CLO05", "topic": "Webhook", "q": "สถานการณ์ใดเหมาะกับการใช้ Webhook มากที่สุด", "choices": ["แจ้งหัวหน้างานทันทีเมื่อเครื่องจักรหยุด", "แสดงกราฟอุณหภูมิที่เปลี่ยนทุกวินาที", "โหลดรายชื่อพนักงานครั้งเดียวตอนเปิดหน้า", "คำนวณคะแนนในเบราว์เซอร์"], "answer": 0, "why": "Webhook ส่งข้อมูลทันทีเมื่อเกิดเหตุการณ์ (Push) เหมาะกับการแจ้งเตือนที่เกิดไม่บ่อยแต่ต้องรู้ทันที"}, {"clo": "CLO06", "topic": "Levels of Testing", "q": "การทดสอบว่าหน้าเว็บกับ API ทำงานร่วมกันได้ถูกต้อง เป็นการทดสอบระดับใด", "choices": ["Unit Testing", "Integration Testing", "User Acceptance Testing", "ไม่ต้องทดสอบ"], "answer": 1, "why": "Integration Testing ทดสอบการเชื่อมต่อระหว่างส่วนต่าง ๆ ของระบบ (อ้างอิง ISO/IEC/IEEE 29119 และ ISTQB Glossary)"}, {"clo": "CLO06", "topic": "Test Case", "q": "ระบบต้องแจ้งเตือนเมื่อแรงดัน \"เกิน 240 V\" ข้อมูลทดสอบชุดใดตรวจค่าขอบ (Boundary) ได้ดีที่สุด", "choices": ["100 และ 500", "0 อย่างเดียว", "230 อย่างเดียว", "240 (ต้องไม่เตือน) และ 240.1 (ต้องเตือน)"], "answer": 3, "why": "ค่าขอบคือค่าที่อยู่ตรงเส้นแบ่ง ถ้าเงื่อนไขเขียนผิดเป็น >= จะจับได้จากค่า 240 (อ้างอิง Boundary Value Analysis ตาม ISO/IEC/IEEE 29119-4 และ ISTQB)"}], "partB": [{"clo": "CLO02, CLO05", "points": 10, "q": "API ของไลน์ผลิตตอบกลับเป็น JSON นี้\n{\"line\": \"A\", \"output\": 1050, \"target\": 1200}\n\nผู้เรียนคนหนึ่งเขียนโค้ดดังนี้\n\nasync function loadLine() {\n  const res = await fetch('/api/line/A');\n  const data = res.json();\n  document.querySelector('#output').textContent = data.output;\n}", "tasks": ["(ก) ตัวแปร data เก็บอะไร และ data.output มีค่าอะไร เพราะเหตุใด (3 คะแนน)", "(ข) แก้โค้ดให้แสดงค่า 1050 ได้ถูกต้อง (3 คะแนน)", "(ค) เพิ่มการตรวจ response.ok และแสดงข้อความ \"โหลดข้อมูลไม่สำเร็จ\" ใน #output เมื่อเกิดข้อผิดพลาด (4 คะแนน)"], "lines": 24, "key": ["(ก) data เก็บ Promise ไม่ใช่ข้อมูล เพราะ res.json() ทำงานแบบ async แต่ไม่ได้ใส่ await ดังนั้น data.output มีค่า undefined (3: บอกได้ว่าเป็น Promise 1 คะแนน, undefined 1 คะแนน, สาเหตุคือขาด await 1 คะแนน)", "(ข) เปลี่ยนเป็น const data = await res.json(); (3: ใส่ await ถูกตำแหน่ง)", "(ค) ใส่ try/catch, ถ้า !res.ok ให้ throw new Error('HTTP ' + res.status) และใน catch กำหนด textContent = 'โหลดข้อมูลไม่สำเร็จ' (4: ตรวจ res.ok 2 คะแนน, แสดงข้อความเมื่อผิดพลาดรวมกรณีเครือข่ายล่ม 2 คะแนน)", "อ้างอิง: Fetch Living Standard (WHATWG) fetch reject เฉพาะเมื่อเกิด network error จึงต้องตรวจ response.ok เอง"], "sample": "async function loadLine() {\n  const out = document.querySelector('#output');\n  try {\n    const res = await fetch('/api/line/A');\n    if (!res.ok) throw new Error('HTTP ' + res.status);\n    const data = await res.json();\n    out.textContent = data.output;\n  } catch (err) {\n    out.textContent = 'โหลดข้อมูลไม่สำเร็จ';\n  }\n}"}, {"clo": "CLO06", "points": 10, "q": "Requirement: ช่องกรอก \"จำนวนชิ้นงานเสีย\" รับเฉพาะจำนวนเต็มตั้งแต่ 0 ถึง 100 ถ้ากรอกค่าที่เกิน 100 ค่าติดลบ หรือค่าที่ไม่ใช่ตัวเลข ระบบต้องแสดงข้อความ \"ข้อมูลไม่ถูกต้อง\" และไม่บันทึกข้อมูล", "tasks": ["เขียน Test Case อย่างน้อย 4 กรณี ในตารางด้านล่าง ให้มีทั้งกรณีปกติ กรณีค่าขอบ และกรณีข้อมูลผิดรูปแบบ (10 คะแนน)"], "table": ["Test Case ID", "ข้อมูลทดสอบ", "ขั้นตอน", "ผลที่คาดหวัง"], "rows": 7, "key": ["กรณีปกติ เช่น กรอก 5 แล้วบันทึกได้ (2 คะแนน)", "ค่าขอบด้านล่างและบน: 0 และ 100 ต้องบันทึกได้ (2 คะแนน)", "นอกขอบ: -1 และ 101 ต้องแสดง \"ข้อมูลไม่ถูกต้อง\" และไม่บันทึก (2 คะแนน)", "ข้อมูลผิดรูปแบบ: ตัวอักษร เช่น abc หรือทศนิยม เช่น 2.5 ต้องแสดง \"ข้อมูลไม่ถูกต้อง\" (2 คะแนน)", "ผลที่คาดหวังเขียนให้วัดได้ชัดเจน เช่น ระบุข้อความที่ต้องแสดงและบอกว่าบันทึกหรือไม่บันทึก (2 คะแนน)", "อ้างอิง: เทคนิค Boundary Value Analysis และ Equivalence Partitioning ตาม ISO/IEC/IEEE 29119-4 และ ISTQB"], "sample": "TC-01 | 5 | กรอกแล้วกดบันทึก | บันทึกสำเร็จ ไม่มีข้อความแจ้งเตือน\nTC-02 | 0 และ 100 | กรอกทีละค่าแล้วกดบันทึก | บันทึกสำเร็จทั้งสองค่า\nTC-03 | -1 และ 101 | กรอกทีละค่าแล้วกดบันทึก | แสดง \"ข้อมูลไม่ถูกต้อง\" และไม่บันทึก\nTC-04 | abc | กรอกแล้วกดบันทึก | แสดง \"ข้อมูลไม่ถูกต้อง\" และไม่บันทึก\nTC-05 | 2.5 | กรอกแล้วกดบันทึก | แสดง \"ข้อมูลไม่ถูกต้อง\" และไม่บันทึก"}]};
  const form = FormApp.create('ข้อสอบทฤษฎี: ' + exam.subject);
  form.setIsQuiz(true);
  form.setDescription(exam.instructions.join('\n'));
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);
  const activeSheet = SpreadsheetApp.getActiveSpreadsheet();
  if (activeSheet) form.setDestination(FormApp.DestinationType.SPREADSHEET, activeSheet.getId());

  // ข้อมูลผู้เรียน
  form.addTextItem().setTitle('รุ่น / คอร์ส (เช่น คอร์สที่ 1)').setRequired(true);
  form.addTextItem().setTitle('เลขที่ (ตามใบรายชื่อ)').setRequired(true);
  form.addTextItem().setTitle('ชื่อ - นามสกุล').setRequired(true);
  form.addTextItem().setTitle('แผนก / หน่วยงาน').setRequired(false);

  form.addSectionHeaderItem()
    .setTitle('ตอนที่ 1: ปรนัย 30 ข้อ (30 คะแนน)')
    .setHelpText('เลือกคำตอบที่ถูกต้องที่สุดเพียงข้อเดียว (ตรวจให้คะแนนอัตโนมัติข้อละ 1 คะแนน)');

  exam.partA.forEach((q, idx) => {
    const item = form.addMultipleChoiceItem();
    const choices = q.choices.map((c, cIdx) => item.createChoice(c, cIdx === q.answer));
    item.setTitle((idx + 1) + '. ' + q.q)
        .setChoices(choices)
        .setPoints(1)
        .setRequired(true);
    const fb = FormApp.createFeedback().setText(q.why).build();
    item.setFeedbackForCorrect(fb);
    item.setFeedbackForIncorrect(fb);
  });

  form.addSectionHeaderItem()
    .setTitle('ตอนที่ 2: อัตนัย 2 ข้อ (20 คะแนน)')
    .setHelpText('เขียนอธิบายและแก้ไขโค้ดตามโจทย์ (ข้อละ 10 คะแนน)');

  exam.partB.forEach((q, idx) => {
    const pItem = form.addParagraphTextItem();
    pItem.setTitle('อัตนัย ข้อ ' + (idx + 1) + ' (' + q.points + ' คะแนน):\n' + q.q)
         .setHelpText(q.tasks.join('\n'))
         .setPoints(q.points)
         .setRequired(true);
  });

  Logger.log('สร้าง Google Form ข้อสอบทฤษฎีสำเร็จ!');
  Logger.log('ลิงก์สำหรับส่งให้ผู้เรียนทำข้อสอบ: ' + form.getPublishedUrl());
  Logger.log('ลิงก์สำหรับผู้สอนแก้ไขฟอร์ม: ' + form.getEditUrl());
}

